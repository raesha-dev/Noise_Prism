# Server-side Gnani credential. Never expose it to frontend variables.
GNANI_API_KEY=

# Use the official defaults for real service, or local mock URLs for plumbing tests.
GNANI_BASE_URL=https://api.vachana.ai
GNANI_WS_URL=wss://api.vachana.ai/stt/v3/stream

# Backend data root. Defaults to bharatnoise_api/.
BN_DATA_DIR=

# Browser origins allowed by the backend, comma-separated.
BN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional demo protection token. Leave empty to disable.
BN_DEMO_TOKEN=

# Upload cap in MiB; uploaded clips expire after this many minutes.
BN_MAX_UPLOAD_MB=5
BN_TTL_MINUTES=30

# Maximum daily Prisma calls reserved by queued jobs.
BN_DAILY_CALL_CAP=300

# Live stream cap, post-stop grace, and outbound frame interval in milliseconds.
BN_LIVE_MAX_SECONDS=300
BN_LIVE_STOP_GRACE_S=3
BN_LIVE_FRAME_MS=64

# Optional frontend API override; default is http://127.0.0.1:8000.
VITE_BHARATNOISE_API_URL=
